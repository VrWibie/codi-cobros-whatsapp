# pey (https://docs.pey.mx) — no hay ambiente test: probar en producción con $0.01 MXN
PEY_API_KEY=
PEY_WEBHOOK_SECRET=whsec_...
# CLABE registrada en pey (opcional; si falta, paga a la cuenta ligada a la API key)
PEY_BANK_ACCOUNT_ID=
# Tope por cobro (CoDi históricamente: 8000)
MAX_AMOUNT=8000

# IA (opcional: sin clave se usa el parser por reglas)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=cambia-esto
# URL pública de este servidor (para enviar el QR como imagen)
PUBLIC_URL=https://tu-dominio.example
PORT=3000

# Demo sin API key ni dinero real (pey simulado): DEMO_MODE=1 npm run dev  →  /demo y /panel
DEMO_MODE=
